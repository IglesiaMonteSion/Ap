[Unit]
Description=qchain validator node
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
# Expects /opt/qchain (or wherever WorkingDirectory points) to contain
# config.json, keypair.json, and an empty data/ directory - see
# docs/DEPLOY.md. Uses --network host so listen_addr/rpc_addr bind
# directly to the machine's real interface, same as a bare-metal run.
Type=simple
WorkingDirectory=/opt/qchain
ExecStartPre=-/usr/bin/docker rm -f qchain-validator
ExecStart=/usr/bin/docker run --rm --name qchain-validator \
  --network host \
  -v /opt/qchain:/qchain -w /qchain \
  qchain:latest qchain-node --config config.json
ExecStop=/usr/bin/docker stop qchain-validator
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
