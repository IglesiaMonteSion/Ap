[Unit]
Description=qchain faucet
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
# Expects /opt/qchain-faucet to contain faucet-keypair.json - see
# docs/DEPLOY.md for --amount/--cooldown-secs tuning and the RPC target.
# Uses --network host, same as qchain-validator.service and for the same
# reason: without it, this container's own 127.0.0.1 is its own loopback,
# not the host's - a faucet co-located with a validator on the same box
# (the natural first thing to try, since this unit ships a working
# default instead of a placeholder) would never actually reach
# --rpc http://127.0.0.1:8080. With host networking the port mapping
# below is unnecessary (the container binds directly to the host's
# 9090), same as the validator unit needs no port mapping either.
Type=simple
WorkingDirectory=/opt/qchain-faucet
ExecStartPre=-/usr/bin/docker rm -f qchain-faucet
# Resource limits (task #199, QCH-S14) - see qchain-validator.service for the
# full rationale. The faucet is a small hot-wallet web service; lighter caps.
ExecStart=/usr/bin/docker run --rm --name qchain-faucet \
  --network host \
  --security-opt no-new-privileges \
  --cap-drop ALL \
  --memory 1g --memory-swap 1g \
  --pids-limit 2048 \
  --ulimit nofile=16384:16384 \
  -v /opt/qchain-faucet:/qchain -w /qchain \
  qchain:latest qchain-faucet \
    --rpc http://127.0.0.1:8080 \
    --keypair /qchain/faucet-keypair.json \
    --listen 0.0.0.0:9090 \
    --amount 10000000 \
    --cooldown-secs 60
ExecStop=/usr/bin/docker stop qchain-faucet
Restart=on-failure
RestartSec=5s
LimitNOFILE=16384
TasksMax=2048
MemoryMax=1G
MemoryHigh=768M

[Install]
WantedBy=multi-user.target
